# TEMPLATE for the Caddy config (automatic HTTPS via Let's Encrypt).
# Don't edit by hand: `./setup.sh` renders the real `Caddyfile` with the domain
# and password hash. The rendered file holds the hash, so it is git-ignored.
__DOMAIN__ {
	encode gzip

	# --- PUBLIC tracking routes: open (prospects must not log in) ---
	@public path /p/* /t/*
	handle @public {
		reverse_proxy app:3000
	}

	# LinkedIn executor (extension): authenticated by its account token
	# (X-LI-Account header, checked by the app), not the dashboard password.
	# Without a token these routes stay behind the password (default account).
	@li_exec {
		path /api/li/next /api/li/result /api/li/inbox /api/li/status
		header_regexp X-LI-Account ^\S+$
	}
	handle @li_exec {
		reverse_proxy app:3000
	}

	# --- Everything else (dashboard, /api, /auth): password-protected ---
	# bcrypt hash injected by setup.sh (user "admin").
	handle {
		basic_auth {
			admin __CADDY_HASH__
		}
		reverse_proxy app:3000
	}

	# basic_auth returns its 401 through Caddy's error path, so a plain
	# `header`/`defer` can't strip WWW-Authenticate: do it in handle_errors.
	# Otherwise Chrome shows its native login box on every /api fetch (popups in
	# a loop while the extension polls /api/li). The 401 itself stays; the
	# dashboard keeps the challenge (native login once).
	handle_errors {
		@api path /api/*
		handle @api {
			header -WWW-Authenticate
			respond {http.error.status_code}
		}
		handle {
			respond {http.error.status_code}
		}
	}
}
