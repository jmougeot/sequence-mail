# --- Server ---
PORT=3000
# Unsubscribe links point to BASE_URL, so they only work if BASE_URL is PUBLIC
# (deployment, tunnel such as `ngrok http 3000`, or a subdomain).
BASE_URL=http://localhost:3000

# --- Google OAuth (console.cloud.google.com > Credentials > OAuth client "Web application") ---
# Optional: can also be set in Settings. Redirect URI: <BASE_URL>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Search engine for LinkedIn prospecting (strongly recommended) ---
# Without a key the app scrapes public engines (Yahoo, Ecosia…): free but quickly
# blocked. ONE key is enough; priority Google > Serper > Brave.
# 1) Serper.dev (recommended): real Google results, 2,500 free queries then ~$1/1000.
SERPER_API_KEY=
# 2) Google Programmable Search: EXISTING ACCOUNTS ONLY. Since Jan 2026 the Custom
#    Search JSON API is closed to new customers (403 "This project does not have
#    the access" even with the API enabled). If you still have access: key from
#    console.cloud.google.com, CX from programmablesearchengine.google.com
#    (limited to 50 domains: `*.linkedin.com` is enough).
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=
# 3) Brave Search API: paid since 2026 (~$5/1000), card required.
BRAVE_SEARCH_API_KEY=

# --- Deliverability ---
# Default daily sending quota for each connected account
DEFAULT_DAILY_LIMIT=40
# Sending window, in SEND_WINDOW_TZ (empty = server time zone)
SEND_WINDOW_START=9
SEND_WINDOW_END=18
SEND_WINDOW_TZ=Europe/Paris
# Send on weekdays only (Monday-Friday)
WEEKDAYS_ONLY=true
# Min / max delay (seconds) between two sends from the same account
MIN_GAP_SECONDS=90
MAX_GAP_SECONDS=420
# Warm-up (accounts with warm-up on): start at WARMUP_START emails/day and add
# WARMUP_RAMP each week up to the account quota. Essential on a new domain.
WARMUP_START=5
WARMUP_RAMP=5

# --- LinkedIn (sequence steps) ---
# Per-account daily caps (applied from day one, no ramp-up)
LI_INVITES_PER_DAY=20
LI_MESSAGES_PER_DAY=40
# Message hours, in LI_HOUR_TZ (empty = server time zone; the container runs in UTC).
# Daily caps reset at midnight in that zone; the inbox is read from 1 h before to 3 h after.
LI_HOUR_START=9
LI_HOUR_END=18
LI_HOUR_TZ=
# Invites: from this time, last one before this time (HH:MM, in SEND_WINDOW_TZ)
LI_INVITE_FROM=08:00
LI_INVITE_UNTIL=21:30
# Message to a not-yet-connected contact: retried every N hours, for at most N days
LI_MESSAGE_RETRY_HOURS=24
LI_MESSAGE_RETRY_MAX_DAYS=21
# Each day's cap is drawn between this % and 100 % of the daily cap
LI_CAP_FLOOR_PCT=60
# Hours move each day: start up to N min later, stop up to N min earlier
LI_WINDOW_JITTER_MIN=75
# Sessions: LI_SESSION_MIN–MAX actions LI_MIN/MAX_GAP_SEC apart, then a rest of LI_REST_MIN–MAX minutes
LI_SESSION_MIN=2
LI_SESSION_MAX=5
LI_MIN_GAP_SEC=120
LI_MAX_GAP_SEC=420
LI_REST_MIN=60
LI_REST_MAX=150
# Inbox read (reply detection): at most every N minutes per profile, at a session start
LI_INBOX_EVERY_MIN=120
# Server-side browsers: session/proxy encryption key and secret shared with the runner
# (openssl rand -base64 32 / openssl rand -hex 32)
LI_SECRET_KEY=
LI_RUNNER_SECRET=
# Optional partner integration: comma-separated owners whose extension performs the
# sends itself (e.g. partner:u:1); it gets its token at pairing. Empty = extensions
# only link LinkedIn.
LI_EXTENSION_OWNERS=
# Owners (e.g. partner:u:1) whose account also sends the dashboard's campaigns: a dashboard account on
# the same LinkedIn profile is merged into theirs, so each profile has one account. Empty = never merged.
LI_DASHBOARD_OWNERS=
# Where a Gmail connection started from the partner app returns (its settings page).
AZERIT_RETURN_URL=

# --- Service API (optional partner integration, internal network) ---
# Shared key for a trusted backend (openssl rand -hex 32). Empty = API disabled.
SERVICE_API_KEY=
