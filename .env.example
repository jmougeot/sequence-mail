# --- Serveur ---
PORT=3000
# IMPORTANT pour le suivi des emails : le pixel d'ouverture et les liens cliqués
# pointent vers BASE_URL. Ils ne fonctionnent que si BASE_URL est PUBLIC (pas
# localhost) — déploiement, tunnel (ngrok http 3000) ou sous-domaine vers l'app.
BASE_URL=http://localhost:3000

# --- Suivi des emails (ouverture + clic) ---
# Activé par défaut. L'ouverture (pixel) est peu fiable (Apple Mail Privacy
# Protection et Gmail préchargent/masquent les images) ; le clic est le signal sûr.
TRACK_ENABLED=true
TRACK_OPENS=true
TRACK_CLICKS=true

# --- Lien personnalisé par prospect ({{link}} dans le corps de l'email) ---
# Placez {{link}} dans vos emails : chaque prospect reçoit un lien unique et stable.
# Quand il l'ouvre, la visite est journalisée (qui, quand, device) puis le prospect
# est redirigé vers VISIT_DEST_URL. C'est le signal d'intérêt le plus fiable.
VISIT_ENABLED=true
# Domaine qui sert CETTE app, idéalement un sous-domaine de votre marque pour une
# URL crédible (ex. https://sequence.example.com). Doit être PUBLIC. Par défaut = BASE_URL.
VISIT_BASE_URL=https://sequence.example.com
# Page publique vers laquelle rediriger après avoir journalisé la visite.
VISIT_DEST_URL=https://www.example.com

# --- Google OAuth (console.cloud.google.com > Credentials > OAuth client "Web application") ---
# URI de redirection à déclarer : http://localhost:3000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Moteur de recherche pour la prospection LinkedIn (fortement recommandé) ---
# Sans clé, l'app retombe sur le scraping de moteurs publics (Yahoo, Ecosia…) :
# gratuit mais vite bloqué (anti-bot). UNE seule clé suffit, priorité Google > Serper > Brave.
# 1) Serper.dev (recommandé) : vrais résultats Google, 2 500 requêtes offertes puis ~1 $/1000.
SERPER_API_KEY=
# 2) Google Programmable Search : ANCIENS COMPTES SEULEMENT. Depuis janv. 2026 la
#    Custom Search JSON API est fermée aux nouveaux clients (403 "This project does
#    not have the access" même API activée). Si vous y avez encore accès :
#    clé via console.cloud.google.com, CX via programmablesearchengine.google.com
#    (moteur limité à 50 domaines : mettre `*.linkedin.com`, ça suffit à l'app).
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=
# 3) Brave Search API : payant depuis 2026 (~5 $/1000), carte requise.
BRAVE_SEARCH_API_KEY=

# --- Attio (bonus, optionnel) ---
ATTIO_API_KEY=
ATTIO_STAGE_ATTRIBUTE=

# --- Délivrabilité ---
# Quota d'envoi quotidien par défaut pour chaque compte connecté
DEFAULT_DAILY_LIMIT=40
# Fenêtre d'envoi (heure locale du serveur)
SEND_WINDOW_START=9
SEND_WINDOW_END=18
# Envoi uniquement en semaine (lundi-vendredi)
WEEKDAYS_ONLY=true
# Délai minimal / maximal (secondes) entre deux envois d'un même compte
MIN_GAP_SECONDS=90
MAX_GAP_SECONDS=420
